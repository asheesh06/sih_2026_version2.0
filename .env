# =======================================================
# SICP BACKEND & APPLICATION ENVIRONMENT VARIABLES
# =======================================================
# Location Restriction Configuration:
# Set to 'true' to allow citizens to report problems from ANY location/state across India.
# Set to 'false' to restrict problem reporting strictly to Jharkhand state only.
# Default: true
ALLOW_ALL_LOCATIONS=true
VITE_ALLOW_ALL_LOCATIONS=true

# Server Configuration
PORT=3000
NODE_ENV=development

# Database (Leave empty to use embedded persistent JSON database at sicp/server/data/local_mongoose_db.json)
MONGODB_URI=

# Authentication
JWT_SECRET=super_secret_sicp_jwt_key_jharkhand_2025

# Gemini AI (Optional for AI classification and translation)
GEMINI_API_KEY=

# Client origin for CORS (leave empty for same-origin / all origins)
CLIENT_ORIGIN=

# Server Port (Render sets this automatically)
PORT=4000
NODE_ENV=production

# Frontend URL on Vercel for CORS (e.g. https://your-project.vercel.app or leave empty to allow all)
CLIENT_ORIGIN=

# Optional: MongoDB connection string (e.g. MongoDB Atlas)
# If left empty, the server automatically uses the embedded persistent JSON database
MONGODB_URI=

# JWT Secret for authentication tokens (put any random strong secret)
JWT_SECRET=super_secret_sicp_jwt_key_jharkhand_2025

# Optional: Gemini API Key for dynamic translations and AI categorization
GEMINI_API_KEY=
